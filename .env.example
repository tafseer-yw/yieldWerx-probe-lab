# Copy to .env (or .env.<env>) and fill in. Never commit real values.
# Active environment (matches config/environments/<name>.json)
E2E_ENV=local

# URL overrides (optional)
# E2E_BASE_URL=http://localhost:3000
# E2E_API_BASE_URL=http://localhost:5000

# Role credentials — role names match config/environments/<env>.json auth.roles
# E2E_AUTH_ROLE=admin
# E2E_AUTH_MOCK=false
# E2E_ADMIN_USERNAME=
# E2E_ADMIN_PASSWORD=
# E2E_ENGINEER_USERNAME=
# E2E_ENGINEER_PASSWORD=
# E2E_VIEWER_USERNAME=
# E2E_VIEWER_PASSWORD=

# SQL Server (rule-engine assertions). E2E_DB_MOCK=true uses the in-memory stub.
# E2E_DB_MOCK=true
# E2E_DB_SERVER=
# E2E_DB_PORT=1433
# E2E_DB_DATABASE=
# E2E_DB_USERNAME=
# E2E_DB_PASSWORD=
# E2E_DB_TRUST_SERVER_CERTIFICATE=false

# yieldWerx Wafer Intelligence application (local SQL Server)
# Keep the password only in your local .env; Compose requires it explicitly.
# WI_API_HOST=0.0.0.0
# WI_API_PORT=5000
# WI_AUTH_SECRET=replace-with-at-least-32-random-characters
# WI_AUTH_TOKEN_TTL_SECONDS=28800
# WI_AUTH_MODE=local
# WI_ENTRA_TENANT_ID=
# WI_ENTRA_AUDIENCE=
# WI_API_RATE_LIMIT_MAX=300
# WI_DEMO_PASSWORD=choose-a-local-demo-password
# WI_DB_SERVER=localhost
# WI_DB_PORT=14333
# WI_DB_HOST_PORT=14333
# WI_DB_NAME=YieldWerxWaferIntelligence
# WI_DB_USER=sa
# WI_DB_PASSWORD=
# WI_DB_ENCRYPT=false
# WI_DB_TRUST_SERVER_CERTIFICATE=true

# Jira filing. `npm run bug:sync` is always a dry run unless --live is passed
# (or JIRA_SYNC_MODE=live is set). Live mode requires HTTPS and all values.
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
# JIRA_ISSUE_TYPE=Bug

# Jira AIO Tests case sync. Generate a personal token in AIO Tests and keep it
# only in your local .env. AIO_EMAIL is needed only when config/aio-sync.json
# uses "auth": "basic"; the default "aioauth" mode needs only the token.
# AIO_API_TOKEN=
# AIO_EMAIL=
# AIO_API_BASE_URL=https://tcms.aiojiraapps.com/aio-tcms/api/v1
# AIO_PROJECT_KEY=

# PROBE Owner bypass. Do not send these values through Claude or commit them.
# Run `probe owner-bypass setup` to create/rotate both values in your local
# gitignored .env through hidden terminal input.
# PROBE_OWNER_BYPASS_PIN=
# PROBE_OWNER_BYPASS_SIGNING_KEY=

# HAR recording may capture credentials and application data. Both flags are
# required to record; sanitize the result before it is reviewed or committed.
# PW_HAR_RECORD=1
# PW_HAR_RECORD_ACK_SENSITIVE=1

# Logging
# LOG_LEVEL=debug
# LOG_FORMAT=json
