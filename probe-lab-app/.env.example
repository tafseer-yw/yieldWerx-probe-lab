# Copy to .env and adjust. Defaults work for local practice.
YW_API_HOST=127.0.0.1
YW_API_PORT=5000

# JWT signing secret — must be at least 32 characters.
YW_AUTH_SECRET=probe-lab-local-secret-change-before-sharing

# Bearer token lifetime in seconds (8 hours).
YW_AUTH_TOKEN_TTL_SECONDS=28800

# SQLite database file path. The setup script creates this file.
YW_DB_PATH=./data/practice-probe-db.sqlite
