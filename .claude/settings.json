{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:*)",
      "Bash(npm test)",
      "Bash(npm run app:*)",
      "Bash(npm run bddgen)",
      "Bash(npm run allure:*)",
      "Bash(npx bddgen*)",
      "Bash(npx playwright test*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.auth/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)"
    ]
  },
  "enabledPlugins": {
    "yw@yieldwerx": true
  },
  "extraKnownMarketplaces": {
    "yieldwerx": {
      "source": {
        "source": "git",
        "url": "https://github.com/tafseer-yw/yieldwerx-probe.git",
        "ref": "main"
      }
    }
  }
}
