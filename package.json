{
  "name": "yieldwerx-probe-lab",
  "version": "0.1.0",
  "private": true,
  "description": "yieldWerx PROBE Lab \u2014 hands-on PROBE practice for Dev and QA",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prebddgen": "node scripts/ensure-deps.mjs root",
    "bddgen": "bddgen",
    "pretest": "node scripts/ensure-deps.mjs root app",
    "test": "npm run test:app && bddgen && playwright test --project=chromium --project=framework-selftest",
    "pretest:app": "node scripts/ensure-deps.mjs app",
    "test:app": "npm run test --prefix probe-lab-app",
    "pretest:smoke": "node scripts/ensure-deps.mjs root",
    "test:smoke": "bddgen && playwright test --grep @smoke --project=chromium",
    "pretest:regression": "node scripts/ensure-deps.mjs root",
    "test:regression": "bddgen && playwright test --grep @regression --project=chromium",
    "pretest:ui": "node scripts/ensure-deps.mjs root",
    "test:ui": "bddgen && playwright test --ui",
    "test:visual": "docker compose -f ci/docker-compose.yml run --rm --build e2e npx playwright test --project=visual --project=framework-selftest",
    "test:visual:baseline": "docker compose -f ci/docker-compose.yml run --rm --build e2e npx playwright test --project=visual --update-snapshots",
    "perf:validate": "docker compose -f performance/docker-compose.yml run --rm k6 inspect /performance/scenarios/wafer-reports.js",
    "perf:smoke": "docker compose -f performance/docker-compose.yml run --rm -e PERF_PROFILE=smoke -e PERF_SUMMARY_PATH=/reports/smoke-summary.json k6",
    "perf:load": "docker compose -f performance/docker-compose.yml run --rm -e PERF_PROFILE=load -e PERF_ALLOW_LOAD=true -e PERF_SUMMARY_PATH=/reports/load-summary.json k6",
    "perf:stress": "docker compose -f performance/docker-compose.yml run --rm -e PERF_PROFILE=stress -e PERF_ALLOW_LOAD=true -e PERF_SUMMARY_PATH=/reports/stress-summary.json k6",
    "perf:spike": "docker compose -f performance/docker-compose.yml run --rm -e PERF_PROFILE=spike -e PERF_ALLOW_LOAD=true -e PERF_SUMMARY_PATH=/reports/spike-summary.json k6",
    "perf:endurance": "docker compose -f performance/docker-compose.yml run --rm -e PERF_PROFILE=endurance -e PERF_ALLOW_LOAD=true -e PERF_SUMMARY_PATH=/reports/endurance-summary.json k6",
    "security:tests": "tsx --test probe-lab-app/tests/security.test.ts",
    "security:deps": "node scripts/security-scan.mjs deps",
    "security:sast": "node scripts/security-scan.mjs sast",
    "security:baseline": "node scripts/security-scan.mjs baseline",
    "precheck:connections": "node scripts/ensure-deps.mjs root",
    "check:connections": "tsx scripts/check-connections.ts",
    "precheck:aio": "node scripts/ensure-deps.mjs root",
    "check:aio": "tsx scripts/check-connections.ts aio",
    "precheck:jira": "node scripts/ensure-deps.mjs root",
    "check:jira": "tsx scripts/check-connections.ts jira",
    "aio:meta": "tsx scripts/aio-probe-meta.ts",
    "aio:tags": "tsx scripts/aio-probe-tags.ts",
    "aio:history": "tsx scripts/aio-probe-history.ts",
    "aio:detail": "tsx scripts/aio-case-detail.ts",
    "aio:dup": "tsx scripts/aio-probe-dup.ts",
    "aio:dedupe": "tsx scripts/aio-dedupe-cases.ts",
    "aio:verify": "tsx scripts/aio-verify-sync.ts",
    "bug:sync": "tsx scripts/jira-bug-sync.ts",
    "ui:contract": "tsx scripts/gen-ui-contract.ts",
    "ui:check": "tsx scripts/check-ui-contract.ts",
    "ui:impact": "tsx scripts/ui-change-impact.ts",
    "pretypecheck": "node scripts/ensure-deps.mjs root",
    "typecheck": "tsc --noEmit",
    "prelint": "node scripts/ensure-deps.mjs root",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "allure:report": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "allure:serve": "allure serve reports/allure-results",
    "jenkins:up": "docker compose -f ci/local/docker-compose.yml up -d --build",
    "jenkins:run": "tsx scripts/jenkins-run.ts",
    "jenkins:logs": "docker compose -f ci/local/docker-compose.yml logs -f jenkins",
    "jenkins:restart": "docker compose -f ci/local/docker-compose.yml restart jenkins",
    "jenkins:down": "docker compose -f ci/local/docker-compose.yml down",
    "clean:reports": "rimraf reports test-results",
    "open:lastreport": "npx playwright show-report reports/playwright-report",
    "prepare": "husky",
    "postinstall": "npm install --prefix probe-lab-app --include=dev --ignore-scripts",
    "preapp:dev": "node scripts/ensure-deps.mjs app",
    "app:dev": "cd probe-lab-app && npm start",
    "preapp:build": "node scripts/ensure-deps.mjs app",
    "app:build": "cd probe-lab-app && npm run build",
    "update:playwright": "npm install -D @playwright/test@latest"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,feature}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "allure-commandline": "2.43.0",
    "allure-playwright": "3.10.2",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import-x": "4.17.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "playwright-bdd": "9.2.0",
    "playwright-odiff": "4.4.2",
    "prettier": "3.9.5",
    "rimraf": "6.0.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "yaml": "2.9.0"
  }
}
